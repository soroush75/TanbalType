<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon><AssemblyName>TanbalType</AssemblyName>
    <RootNamespace>TanbalType</RootNamespace>
    <Version>1.5.0</Version>
    <Description>Auto-fix Persian/English keyboard layout on Windows</Description>

    <!-- سرعتِ بالاآمدن: کدِ از-پیش-کامپایل‌شده و فرهنگ‌های بی‌استفاده حذف‌شده،
         تا JIT در لحظهٔ اجرا کمتر کار کند. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="PersianWords.txt" LogicalName="TanbalType.PersianWords.txt" />
    <!-- آیکن tray از منبعِ تعبیه‌شده خوانده می‌شود (ExtractAssociatedIcon ~۱۲۰ms می‌گرفت) -->
    <EmbeddedResource Include="app.ico" LogicalName="TanbalType.app.ico" />
  </ItemGroup>
</Project>
